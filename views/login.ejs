<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录 - QQ登录网站</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-header">
        <div style="width: 64px; height: 64px; margin: 0 auto 16px; background: linear-gradient(135deg, #12b7f5, #0e8ed8); border-radius: 16px; display: flex; align-items: center; justify-content: center;">
          <svg width="36" height="36" viewBox="0 0 1024 1024" fill="white">
            <path d="M848.3 638.2c-2.8-15-5.6-26.3-5.6-26.3 0 0 4.2-42.2-14.6-102.8 0 0-20.5-94.3-85.7-142.1 0 0 20.8-92.2-24.6-148.5 0 0-2.2-2.2-3.3-3.3C662.6 130.4 575.7 64 512 64c-65 0-153.9 68.5-204 152.3-1.1 1.1-3.3 3.3-3.3 3.3-45.4 56.3-24.6 148.5-24.6 148.5-65.2 47.8-85.7 142.1-85.7 142.1-18.8 60.6-14.6 102.8-14.6 102.8 0 0-2.8 11.3-5.6 26.3-7.7 40.9-12.7 69.7-9 78.9 5.6 14 28.6 18.1 57.4 11.8 34.6-7.5 84.6-29.3 106-50.9 0 0 10.2 32.2 52.4 58.9 0 0-29.1 8.5-34.8 26.8-5.6 18.1 18.1 33.1 52.4 33.1 4.2 0 8.4-.4 12.6-1.1-1 4.5-1.5 9.1-1.5 13.8 0 46.9 32.9 77.3 100.5 77.3 67.6 0 100.5-30.3 100.5-77.3 0-4.7-.6-9.3-1.6-13.8 4.2.7 8.4 1.1 12.6 1.1 34.3 0 58.1-14.9 52.4-33.1-5.8-18.3-34.8-26.8-34.8-26.8 42.2-26.7 52.4-58.9 52.4-58.9 21.4 21.6 71.4 43.4 106 50.9 28.9 6.3 51.9 2.2 57.4-11.8 3.7-9.2-1.3-38-9-78.9z"/>
          </svg>
        </div>
        <h1>欢迎登录</h1>
        <p>使用QQ号和密码登录</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form action="/auth/qq/login" method="post">
        <div class="form-group">
          <label class="form-label">QQ号</label>
          <div class="input-with-avatar">
            <div class="input-avatar" id="avatarPreview">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="#ccc">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
            </div>
            <input type="text" name="qq_number" id="qqInput" class="form-input input-qq" placeholder="请输入QQ号" required pattern="[0-9]{5,12}" maxlength="12" autocomplete="username">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">密码</label>
          <input type="password" name="password" class="form-input" placeholder="请输入密码" required autocomplete="current-password">
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; height: 46px; font-size: 16px; border-radius: 10px;">
          登录
        </button>
      </form>

      <div style="text-align: center; margin-top: 20px; font-size: 14px; color: #666;">
        还没有账号？<a href="/register" style="color: #12b7f5; text-decoration: none;">立即注册</a>
      </div>

      <div style="text-align: center; margin-top: 16px; font-size: 12px; color: #bbb;">
        <a href="/" style="color: #bbb; text-decoration: none;">返回首页</a>
      </div>
    </div>
  </div>

  <style>
    .input-with-avatar {
      position: relative;
    }

    .input-avatar {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      overflow: hidden;
      background: #f0f0f0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
    }

    .input-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .input-qq {
      padding-left: 52px !important;
    }
  </style>

  <script>
    const qqInput = document.getElementById('qqInput');
    const avatarPreview = document.getElementById('avatarPreview');

    // 输入QQ号时实时显示头像
    let debounceTimer;
    qqInput.addEventListener('input', function() {
      const qq = this.value.trim();
      
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        if (/^\d{5,12}$/.test(qq)) {
          avatarPreview.innerHTML = `<img src="https://q1.qlogo.cn/g?b=qq&nk=${qq}&s=100" alt="QQ头像" onerror="this.parentElement.innerHTML='<svg width=\\'24\\' height=\\'24\\' viewBox=\\'0 0 24 24\\' fill=#ccc><path d=\\'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\\'/></svg>'">`;
        } else {
          avatarPreview.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="#ccc"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>`;
        }
      }, 200);
    });
  </script>
</body>
</html>
