<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - QQ登录网站</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="navbar-brand">
      <span class="logo">Q</span>
      <span>QQ登录网站</span>
    </a>
    <ul class="navbar-menu">
      <li><a href="/">首页</a></li>
      <% sitePages.forEach(function(page) { %>
        <li><a href="/page/<%= page.page_name %>"><%= page.title %></a></li>
      <% }); %>
      <% if (isLoggedIn) { %>
        <li><a href="/chat" style="opacity: 1;">闲聊室</a></li>
      <% } %>
      <% if (isAdmin) { %>
        <li><a href="/admin/edit">网站编辑</a></li>
        <li><a href="/admin/users">用户管理</a></li>
      <% } %>
    </ul>
    <div class="navbar-user">
      <div class="avatar">
        <% if (currentUser && currentUser.avatar) { %>
          <img src="<%= currentUser.avatar %>" alt="头像">
        <% } %>
      </div>
      <span><%= currentUser ? currentUser.nickname : '用户' %></span>
      <% if (currentUser && currentUser.is_admin) { %>
        <span class="admin-badge">管理员</span>
      <% } %>
      <a href="/logout" style="color: white; text-decoration: none; font-size: 14px;">退出</a>
    </div>
  </nav>

  <div class="container">
    <div class="chat-container">
      <div class="chat-header">
        <h2 style="margin: 0; font-size: 18px;">💬 港州闲聊室</h2>
        <div style="font-size: 13px; color: #999;">
          <span id="onlineCount">在线人数: --</span>
        </div>
      </div>

      <div class="chat-messages" id="chatMessages">
        <div style="text-align: center; color: #999; padding: 40px;">
          加载消息中...
        </div>
      </div>

      <div class="chat-input-area">
        <div class="chat-toolbar">
          <button class="chat-tool-btn" onclick="document.getElementById('chatImageInput').click()" title="发送图片">
            🖼️ 斗图
          </button>
          <input type="file" id="chatImageInput" accept="image/*" style="display: none;" onchange="sendChatImage()">
          <span style="font-size: 12px; color: #999; margin-left: 8px;">支持 JPG、PNG、GIF，最大 5MB</span>
        </div>
        <div class="chat-input-wrapper">
          <textarea id="chatInput" class="chat-input" placeholder="说点什么吧..." 
                    onkeydown="handleChatKeydown(event)"></textarea>
          <button class="btn btn-primary chat-send-btn" onclick="sendChatMessage()">发送</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .chat-container {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      display: flex;
      flex-direction: column;
      height: calc(100vh - 180px);
      min-height: 500px;
      overflow: hidden;
    }

    .chat-header {
      padding: 16px 20px;
      border-bottom: 1px solid #f0f0f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(135deg, #12b7f5 0%, #0099ff 100%);
      color: white;
    }

    .chat-header h2 {
      color: white;
    }

    .chat-header #onlineCount {
      color: rgba(255, 255, 255, 0.8);
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      background: #f7f9fc;
    }

    .message-item {
      display: flex;
      margin-bottom: 16px;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .message-item.self {
      flex-direction: row-reverse;
    }

    .message-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      background: #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .message-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .message-content {
      max-width: 65%;
      margin: 0 12px;
    }

    .message-item.self .message-content {
      text-align: right;
    }

    .message-info {
      font-size: 12px;
      color: #999;
      margin-bottom: 4px;
    }

    .message-item.self .message-info {
      text-align: right;
    }

    .message-nickname {
      font-weight: 500;
      color: #666;
      margin-right: 8px;
    }

    .message-item.self .message-nickname {
      margin-right: 0;
      margin-left: 8px;
    }

    .message-bubble {
      display: inline-block;
      padding: 10px 14px;
      border-radius: 12px;
      background: white;
      word-break: break-word;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
      text-align: left;
    }

    .message-item.self .message-bubble {
      background: #12b7f5;
      color: white;
    }

    .message-bubble img {
      max-width: 200px;
      max-height: 200px;
      border-radius: 8px;
      display: block;
      cursor: pointer;
    }

    .message-item.self .message-bubble img {
      margin-left: auto;
    }

    .chat-input-area {
      border-top: 1px solid #f0f0f0;
      background: white;
      padding: 12px 16px;
    }

    .chat-toolbar {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
    }

    .chat-tool-btn {
      background: none;
      border: none;
      padding: 6px 12px;
      font-size: 14px;
      cursor: pointer;
      border-radius: 6px;
      color: #666;
      transition: all 0.2s;
    }

    .chat-tool-btn:hover {
      background: #f0f7ff;
      color: #12b7f5;
    }

    .chat-input-wrapper {
      display: flex;
      gap: 12px;
    }

    .chat-input {
      flex: 1;
      resize: none;
      padding: 10px 14px;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      font-size: 14px;
      line-height: 1.5;
      outline: none;
      transition: border-color 0.2s;
      height: 60px;
      font-family: inherit;
    }

    .chat-input:focus {
      border-color: #12b7f5;
    }

    .chat-send-btn {
      height: 60px;
      padding: 0 24px;
      font-size: 15px;
    }

    .chat-tips {
      text-align: center;
      color: #bbb;
      font-size: 12px;
      padding: 8px 0;
    }

    .chat-tips span {
      background: #eef2f7;
      padding: 4px 12px;
      border-radius: 12px;
    }
  </style>

  <script>
    let lastMessageId = 0;
    let isLoading = false;
    let pollInterval = null;

    // 初始化
    document.addEventListener('DOMContentLoaded', function() {
      loadMessages();
      startPolling();
    });

    // 加载消息
    function loadMessages() {
      if (isLoading) return;
      isLoading = true;

      fetch('/api/chat/messages')
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            renderMessages(data.messages);
            if (data.messages.length > 0) {
              lastMessageId = data.messages[data.messages.length - 1].id;
            }
            scrollToBottom();
          }
        })
        .catch(err => {
          console.error('加载消息失败:', err);
        })
        .finally(() => {
          isLoading = false;
        });
    }

    // 轮询新消息
    function startPolling() {
      pollInterval = setInterval(function() {
        if (lastMessageId === 0) return;
        
        fetch('/api/chat/messages?since_id=' + lastMessageId)
          .then(res => res.json())
          .then(data => {
            if (data.success && data.messages.length > 0) {
              appendMessages(data.messages);
              lastMessageId = data.messages[data.messages.length - 1].id;
              scrollToBottom();
            }
          })
          .catch(err => {
            console.error('获取新消息失败:', err);
          });
      }, 2000);
    }

    // 渲染消息列表
    function renderMessages(messages) {
      const container = document.getElementById('chatMessages');
      
      if (messages.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; color: #999; padding: 60px 20px;">
            <div style="font-size: 48px; margin-bottom: 12px;">💬</div>
            <div>还没有消息，快来发第一条吧！</div>
          </div>
        `;
        return;
      }

      container.innerHTML = messages.map(msg => renderMessageItem(msg)).join('');
    }

    // 追加新消息
    function appendMessages(messages) {
      const container = document.getElementById('chatMessages');
      const emptyMsg = container.querySelector('[style*="text-align: center"]');
      if (emptyMsg && emptyMsg.textContent.includes('还没有消息')) {
        container.innerHTML = '';
      }
      
      messages.forEach(msg => {
        container.insertAdjacentHTML('beforeend', renderMessageItem(msg));
      });
    }

    // 渲染单条消息
    function renderMessageItem(msg) {
      const isSelf = msg.user_id === <%= currentUser ? currentUser.id : 0 %>;
      const time = formatTime(msg.created_at);
      const avatarHtml = msg.avatar 
        ? `<img src="${msg.avatar}" alt="头像">`
        : `<span>${msg.nickname ? msg.nickname[0] : '?'}</span>`;

      let contentHtml = '';
      if (msg.type === 'image') {
        contentHtml = `<img src="${msg.content}" alt="图片" onclick="window.open('${msg.content}', '_blank')">`;
      } else {
        contentHtml = escapeHtml(msg.content).replace(/\n/g, '<br>');
      }

      return `
        <div class="message-item ${isSelf ? 'self' : ''}">
          <div class="message-avatar">${avatarHtml}</div>
          <div class="message-content">
            <div class="message-info">
              <span class="message-nickname">${escapeHtml(msg.nickname)}</span>
              <span class="message-time">${time}</span>
            </div>
            <div class="message-bubble">${contentHtml}</div>
          </div>
        </div>
      `;
    }

    // 发送文字消息
    function sendChatMessage() {
      const input = document.getElementById('chatInput');
      const content = input.value.trim();
      
      if (!content) {
        return;
      }

      input.disabled = true;
      
      fetch('/api/chat/send', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ content: content })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          input.value = '';
          // 立即刷新消息
          loadNewMessages();
        } else {
          alert(data.error || '发送失败');
        }
      })
      .catch(err => {
        alert('发送失败，请重试');
      })
      .finally(() => {
        input.disabled = false;
        input.focus();
      });
    }

    // 发送图片消息
    function sendChatImage() {
      const input = document.getElementById('chatImageInput');
      const file = input.files[0];
      
      if (!file) return;

      // 检查文件大小
      if (file.size > 5 * 1024 * 1024) {
        alert('图片大小不能超过5MB');
        input.value = '';
        return;
      }

      const formData = new FormData();
      formData.append('image', file);

      const sendBtn = document.querySelector('.chat-tool-btn');
      const originalText = sendBtn.textContent;
      sendBtn.disabled = true;
      sendBtn.textContent = '上传中...';

      fetch('/api/chat/upload-image', {
        method: 'POST',
        body: formData
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          input.value = '';
          loadNewMessages();
        } else {
          alert(data.error || '上传失败');
        }
      })
      .catch(err => {
        alert('上传失败，请重试');
      })
      .finally(() => {
        sendBtn.disabled = false;
        sendBtn.textContent = originalText;
      });
    }

    // 加载新消息
    function loadNewMessages() {
      if (lastMessageId === 0) {
        loadMessages();
        return;
      }

      fetch('/api/chat/messages?since_id=' + lastMessageId)
        .then(res => res.json())
        .then(data => {
          if (data.success && data.messages.length > 0) {
            appendMessages(data.messages);
            lastMessageId = data.messages[data.messages.length - 1].id;
            scrollToBottom();
          }
        });
    }

    // 回车发送
    function handleChatKeydown(e) {
      if (e.key === 'Enter' && !e.ctrlKey && !e.shiftKey) {
        e.preventDefault();
        sendChatMessage();
      }
    }

    // 滚动到底部
    function scrollToBottom() {
      const container = document.getElementById('chatMessages');
      container.scrollTop = container.scrollHeight;
    }

    // 格式化时间
    function formatTime(isoString) {
      const date = new Date(isoString);
      const now = new Date();
      const diff = now - date;
      
      // 今天内
      if (date.toDateString() === now.toDateString()) {
        return date.getHours().toString().padStart(2, '0') + ':' + 
               date.getMinutes().toString().padStart(2, '0');
      }
      
      // 昨天
      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      if (date.toDateString() === yesterday.toDateString()) {
        return '昨天 ' + date.getHours().toString().padStart(2, '0') + ':' + 
               date.getMinutes().toString().padStart(2, '0');
      }
      
      // 其他
      return (date.getMonth() + 1) + '/' + date.getDate() + ' ' + 
             date.getHours().toString().padStart(2, '0') + ':' + 
             date.getMinutes().toString().padStart(2, '0');
    }

    // HTML转义
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  </script>

  <div class="footer">
    <p>&copy; 2024 QQ登录网站 - 港州闲聊室</p>
  </div>
</body>
</html>
